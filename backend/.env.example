# HumanPatch backend env — copy to .env and fill in. NEVER commit .env (it is gitignored).

# LLM provider: amdradeon | minimax | tokenrouter | (empty = local vLLM)
LLM_PROVIDER=amdradeon

# AMD Radeon Open API (https://developer.amd.com.cn)
LLM_MODEL=DeepSeek-V4-Flash
AMD_RAIDEN_API_KEY=rc-your-key-here

# Optional alternatives:
# LLM_PROVIDER=minimax
# MINIMAX_API_KEY=your-key
# LLM_PROVIDER=tokenrouter
# TOKENROUTER_API_KEY=your-key

# Dev/test: deterministic scripted adversary, no network
# MOCK_LLM=1
